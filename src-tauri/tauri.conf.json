{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "盯盘小助手",
  "version": "0.1.0",
  "identifier": "com.stockwatcher.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "盯盘小助手",
        "url": "index.html",
        "width": 340,
        "height": 200,
        "minWidth": 200,
        "minHeight": 40,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "center": true
      },
      {
        "label": "settings",
        "title": "设置 — 盯盘小助手",
        "url": "settings.html",
        "width": 520,
        "height": 560,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
